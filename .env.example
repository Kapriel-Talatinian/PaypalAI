DISPUTEFLOW_ENVIRONMENT=development
DISPUTEFLOW_DATABASE_URL=sqlite:///./disputeflow.db
DISPUTEFLOW_API_KEY=local-development-key-change-me
# DISPUTEFLOW_REVIEWER_API_KEY=use-a-separate-random-key
DISPUTEFLOW_POLICY_DIR=policies
DISPUTEFLOW_LLM_PROVIDER=demo
DISPUTEFLOW_OPENAI_MODEL=gpt-4.1-mini
# DISPUTEFLOW_OPENAI_API_KEY=
DISPUTEFLOW_EXECUTION_MODE=dry_run
DISPUTEFLOW_PAYPAL_ENVIRONMENT=sandbox
# DISPUTEFLOW_PAYPAL_CLIENT_ID=
# DISPUTEFLOW_PAYPAL_CLIENT_SECRET=
# DISPUTEFLOW_PAYPAL_WEBHOOK_ID=
DISPUTEFLOW_WEBHOOK_POLICY_ID=demo_policy
DISPUTEFLOW_AUTO_CONFIDENCE_THRESHOLD=0.95
DISPUTEFLOW_AUTO_MAX_AMOUNT=100
DISPUTEFLOW_AUTO_CURRENCY=USD
DISPUTEFLOW_MAX_REPAIR_ATTEMPTS=2
DISPUTEFLOW_SOLVER_MAX_MODELS=64
DISPUTEFLOW_SOLVER_TIMEOUT_SECONDS=5
DISPUTEFLOW_ANALYSIS_TIMEOUT_SECONDS=180
DISPUTEFLOW_EXECUTION_TIMEOUT_SECONDS=90
DISPUTEFLOW_CORS_ORIGINS=[]
